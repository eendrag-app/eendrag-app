# Copy to .env.local and fill in the values. Where each value comes from is
# documented in README.md ("Environment variables"). Never commit .env.local.

# --- Supabase (Dashboard → Project Settings → API, or `npx supabase projects api-keys`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by the notification pipeline and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Dashboard → Connect → Direct connection).
# Used by RLS tests and manual psql access. Not needed to run the app.
SUPABASE_DB_URL=

# --- Auth (see docs/ARCHITECTURE.md "Auth" for what switching modes involves) ---
# open            = email+password, anyone can sign up (current)
# sun_email_magic_link = @sun.ac.za magic links against the verified_emails table (future)
AUTH_MODE=open
REQUIRE_SUN_EMAIL=false
# Only addresses on the HK's resident list (verified_emails) may create an
# account. This is what replaces email confirmation once that is switched off
# in Supabase — see docs/OPERATIONS.md → Who may create an account.
# Fill the list first (npm run import-residents) or nobody can sign up.
REQUIRE_VERIFIED_EMAIL=false

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scheduled work (docs/OPERATIONS.md "Scheduled work") ---
# Shared secret for /api/cron/tick, which publishes scheduled announcements
# and sends day-of reminders. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`; plain cron can pass ?secret=...
# WITHOUT this set the route refuses to run and scheduled posts never go out —
# the compose screen says so. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# --- Web push (docs/OPERATIONS.md "Notifications on a phone") ---
# VAPID keypair — how a push service knows the notification came from us.
# Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is sent to browsers (hence NEXT_PUBLIC_); the private key is
# server-only. WITHOUT these set, nothing is pushed to phones and the in-app
# bell carries on exactly as before — Profile says so out loud.
# Changing the public key invalidates every existing subscription: everyone
# has to turn notifications on again. Treat it as permanent.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Where a push service should complain if our sends misbehave. An email or a
# https URL, prefixed with mailto: for an address.
WEB_PUSH_CONTACT=mailto:hk@eendrag.example
